# Merge these lines into the EXISTING .env on the PC hosting Laravel + Reverb.
# Do not replace the whole .env with this file.
# Flutter/browser connections continue using likhae.online:443 over HTTPS.
REVERB_BROADCAST_HOST=127.0.0.1
REVERB_BROADCAST_PORT=8080
REVERB_BROADCAST_SCHEME=http
REVERB_CONNECT_TIMEOUT=1
REVERB_HTTP_TIMEOUT=2
