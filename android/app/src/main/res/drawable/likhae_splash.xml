<?xml version="1.0" encoding="utf-8"?>
<!-- Keep the complete mark inside Android 12's circular safe area. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape><solid android:color="@android:color/transparent" /></shape>
    </item>
    <item>
        <inset android:insetLeft="22.2222%" android:insetTop="22.2222%" android:insetRight="22.2222%" android:insetBottom="22.2222%">
            <bitmap android:src="@drawable/likhae_brand_mark" android:gravity="fill" android:filter="true" />
        </inset>
    </item>
</layer-list>


